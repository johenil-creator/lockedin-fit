diff --git a/node_modules/react-native-health/RCTAppleHealthKit/RCTAppleHealthKit+Methods_Workout.m b/node_modules/react-native-health/RCTAppleHealthKit/RCTAppleHealthKit+Methods_Workout.m
index c1c4f42..252af47 100644
--- a/node_modules/react-native-health/RCTAppleHealthKit/RCTAppleHealthKit+Methods_Workout.m
+++ b/node_modules/react-native-health/RCTAppleHealthKit/RCTAppleHealthKit+Methods_Workout.m
@@ -145,6 +145,21 @@ - (void)workout_save: (NSDictionary *)input callback: (RCTResponseSenderBlock)ca
 
             return;
         }
+        // Also save an ActiveEnergyBurned sample so the Move ring reflects workout calories.
+        // The legacy HKWorkout initializer only sets totalEnergyBurned as workout metadata;
+        // the ring reads HKQuantityTypeIdentifierActiveEnergyBurned samples separately.
+        if (totalEnergyBurned != nil) {
+            HKQuantityType *activeEnergyType = [HKQuantityType quantityTypeForIdentifier:HKQuantityTypeIdentifierActiveEnergyBurned];
+            HKQuantitySample *energySample = [HKQuantitySample quantitySampleWithType:activeEnergyType
+                                                                              quantity:totalEnergyBurned
+                                                                             startDate:startDate
+                                                                               endDate:endDate];
+            [self.healthStore saveObject:energySample withCompletion:^(BOOL energySuccess, NSError *energyError) {
+                if (!energySuccess) {
+                    NSLog(@"Warning: Could not save ActiveEnergyBurned sample: %@", energyError);
+                }
+            }];
+        }
         callback(@[[NSNull null], [[workout UUID] UUIDString]]);
     };
 
